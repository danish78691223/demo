# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/webwhale

# MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<encoded-password>@<cluster>/<database>?retryWrites=true&w=majority&appName=webwhale

# REQUIRED: random secret of at least 32 characters.
JWT_SECRET=replace_with_a_random_32_plus_character_secret

# Razorpay TEST/LIVE credentials. Keep the secret server-side only.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Dashboard webhook secret. Keep this server-side only.
RAZORPAY_WEBHOOK_SECRET=replace_with_a_random_webhook_secret

# Public Razorpay key used by the browser checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Optional. Leave empty to use the built-in Next.js /api routes.
NEXT_PUBLIC_API_URL=

# OAuth 2.0 / SSO clients. Use exact registered redirect URIs.
# SQLWhale is a public PKCE client and does not use a client secret.
WEBXWHALE_OAUTH_CLIENTS=[{"clientId":"sqlwhale","name":"SQLWhale","type":"public","redirectUris":["http://localhost:5000/api/auth/webxwhale/callback","https://YOUR-SQLWHALE-BACKEND-DOMAIN/api/auth/webxwhale/callback"]}]
