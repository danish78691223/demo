# MongoDB Connection String
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/webwhale
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/webwhale?retryWrites=true&w=majority

# JWT secret key for signing authentication tokens
JWT_SECRET=super_secret_jwt_key_replace_in_production

# Optional: External API URL. Leave blank or omit to use built-in Next.js /api routes.
NEXT_PUBLIC_API_URL=
